  "strategies": {
    "S1": {
      "name": "VWAP momentum continuation",
      "status": "RESEARCH",
      "risk_mult": 1.0,
      "setup": {
        "vwap_side_pct": 80,
        "vwap_side_lookback_bars": 12,
        "vwap_slope_min": 0.1,
        "rvol_min": 1.5,
        "pullback_max_retrace": 0.618,
        "pullback_max_close_below_vwap_atr": 0.25
      },
      "trigger": {
        "min_volume_vs_avg": 1.0
      },
      "entry": {
        "type": "stop",
        "valid_bars": 2
      },
      "stop": {
        "buffer_atr": 0.1,
        "min_atr": 0.5,
        "max_atr": 1.5
      },
      "targets": [
        {
          "id": "T1",
          "r": 1.5,
          "close_pct": 50
        },
        {
          "id": "RUNNER",
          "trail": "pivot_5m",
          "close_pct": 50
        }
      ],
      "exits": {
        "vwap_close": true,
        "ema20_consecutive_closes": 2,
        "time_stop_bars": 6,
        "time_stop_min_r": 0.5
      },
      "avoid": {
        "beyond_vwap_sd": 2,
        "max_leg": 2,
        "level_within_r": 1.0
      },
      "max_attempts": 2
    },
    "S2": {
      "name": "Opening-range breakout",
      "status": "RESEARCH",
      "risk_mult": 1.0,
      "range_minutes": 15,
      "entry_cutoff_minutes": 90,
      "prefilter": {
        "range_rvol_min": 1.5,
        "range_width_adr_min": 0.25,
        "range_width_adr_max": 0.8,
        "max_vwap_crosses_in_range": 2
      },
      "trigger": {
        "close_buffer_atr": 0.1,
        "breakout_volume_vs_range_avg": 1.5,
        "require_above_vwap": true,
        "require_above_open": true
      },
      "entry": {
        "mode": "retest",
        "retest_valid_bars": 6,
        "aggressive_valid_bars": 2
      },
      "stop": {
        "default": "or_mid",
        "buffer_atr": 0.1,
        "min_atr": 0.5,
        "full_range_if_width_adr_lte": 0.35
      },
      "targets": [
        {
          "id": "T1",
          "r": 1.0,
          "close_pct": 33
        },
        {
          "id": "T2",
          "type": "measured_move_or_2r",
          "close_pct": 33
        },
        {
          "id": "RUNNER",
          "trail": "vwap_close",
          "close_pct": 34
        }
      ],
      "exits": {
        "close_back_inside_range": true,
        "arm_s7_on_failure": true
      },
      "max_per_direction": 1
    },
    "S3": {
      "name": "Mean reversion to VWAP",
      "status": "RESEARCH",
      "risk_mult": 0.75,
      "window": {
        "after_open_min": 60,
        "before_close_min": 90,
        "news_buffer_min": 30
      },
      "setup": {
        "vwap_sd_min": 2,
        "or_atr_from_vwap_min": 1.5,
        "rsi14_max": 30,
        "rsi2_max": 5,
        "shrinking_range_bars": 3,
        "climax_volume_vs_avg": 2.5
      },
      "entry": {
        "type": "stop",
        "valid_bars": 2
      },
      "stop": {
        "buffer_atr": 0.25,
        "max_atr": 1.2
      },
      "targets": [
        {
          "id": "T1",
          "level": "vwap_minus_1sd",
          "close_pct": 50
        },
        {
          "id": "T2",
          "level": "vwap",
          "close_pct": 50,
          "min_r": 1.5
        }
      ],
      "exits": {
        "time_stop_bars": 8,
        "adx_above": 25,
        "displacement_against": true
      },
      "max_attempts": 2,
      "stop_direction_after_losses": 1
    },
    "S4": {
      "name": "Range and level trading",
      "status": "RESEARCH",
      "risk_mult": 1.0,
      "level": {
        "min_touches": 2,
        "max_touches_today": 3,
        "min_range_vs_stop_plus_cost": 3
      },
      "stop": {
        "buffer_atr": 0.2,
        "min_spread_multiple": 2
      },
      "targets": [
        {
          "id": "T1",
          "level": "range_mid",
          "close_pct": 50
        },
        {
          "id": "T2",
          "level": "opposite_boundary_minus_spread",
          "close_pct": 50
        }
      ],
      "failure": {
        "close_beyond_level_hold_bars": 2
      },
      "max_attempts_per_level": 2
    },
    "S5": {
      "name": "News and event trading",
      "status": "RESEARCH",
      "risk_mult": 0.5,
      "flatten_before_event_min": 15,
      "wait_after_release_min": 5,
      "max_spread_ratio": 1.5,
      "stop": {
        "buffer_atr": 0.25,
        "max_atr": 2.0
      },
      "targets": [
        {
          "id": "T1",
          "r": 1.0,
          "close_pct": 50
        },
        {
          "id": "T2",
          "r": 2.0,
          "close_pct": 50
        }
      ],
      "exits": {
        "time_stop_min": 30,
        "flat_after_release_min": 90
      },
      "sizing_extra_slippage_r": 0.5,
      "skip_press_conferences": true,
      "backtest_slippage_multiple": 3
    },
    "S6": {
      "name": "Scalping",
      "status": "DISABLED",
      "risk_mult": 0.5,
      "windows": [
        "LONDON_OPEN",
        "OVERLAP"
      ],
      "rvol_min": 1.2,
      "max_spread_ratio": 1.2,
      "setup": {
        "consolidation_min_bars_1m": 6,
        "consolidation_max_range_atr": 0.5
      },
      "stop": {
        "min_atr": 0.3,
        "max_atr": 0.6
      },
      "target_r": [
        1.0,
        1.5
      ],
      "time_stop_bars_1m": 5,
      "max_per_session": 6,
      "stop_after_consecutive_losses": 2,
      "daily_loss_limit_r": 1.5
    },
    "S7": {
      "name": "Failed-breakout reversal",
      "status": "RESEARCH",
      "risk_mult": 1.0,
      "setup": {
        "min_break_atr": 0.1,
        "close_back_inside_within_bars": 3
      },
      "entry": {
        "type": "stop",
        "valid_bars": 2
      },
      "stop": {
        "buffer_atr": 0.1
      },
      "targets": [
        {
          "id": "T1",
          "level": "vwap_or_or_mid",
          "close_pct": 50
        },
        {
          "id": "T2",
          "level": "opposite_range_side",
          "close_pct": 50
        }
      ],
      "max_per_level": 1
    }
  },
